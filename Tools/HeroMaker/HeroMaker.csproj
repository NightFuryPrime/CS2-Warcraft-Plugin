<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WarcraftPlugin\WarcraftPlugin.csproj" />
  </ItemGroup>

  <Target Name="DeployHeroSources" AfterTargets="Build" Condition="'$(CustomHeroDeployDir)' != ''">
    <ItemGroup>
      <HeroSource Include="$(MSBuildProjectDirectory)/*.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(HeroSource)" DestinationFolder="$(CustomHeroDeployDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
